# Directorio que contiene los archivos GGUF.
MODELS_DIR=models

# Ruta a llama-server.exe o a la carpeta que lo contiene.
# Si se deja vacío, el servidor busca una carpeta llama* en el proyecto o en PATH.
LLAMA_SERVER_PATH=

# API local. No cambies LLAMA_HOST salvo que sepas por qué necesitas hacerlo.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Opcional. Si se define, todas las rutas salvo "/" requieren Authorization: Bearer <clave>.
API_KEY=

# Opcionales:
# AGENTS_DIR=config/agentes
# SKILLS_DIR=skills
# LOG_DIR=logs
# STARTUP_TIMEOUT=180
# MODELS_CACHE_TTL=30
# SEARXNG_URL=http://<host-de-tu-SearXNG>:8888
