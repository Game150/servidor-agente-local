# Directorio que contiene los archivos GGUF.
MODELS_DIR=models

# Ruta a llama-server.exe o a la carpeta que lo contiene.
# Si se deja vacío, el servidor busca una carpeta llama* en el proyecto o en PATH.
LLAMA_SERVER_PATH=

# API local. No cambies LLAMA_HOST salvo que sepas por qué necesitas hacerlo.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Modelo GGUF opcional para POST /v1/embeddings. Se carga en otro proceso
# llama-server, sin reemplazar el modelo principal.
EMBEDDINGS_MODEL=
EMBEDDINGS_HOST=127.0.0.1
EMBEDDINGS_PORT=8081
EMBEDDINGS_CTX_SIZE=2048
# 0 mantiene el modelo de embeddings en CPU; aumenta solo si tienes VRAM libre.
EMBEDDINGS_GPU_LAYERS=0

# Búsqueda semántica interna opcional; la API expone indexar_proyecto y buscar_codigo.
# Solicita explícitamente la indexación desde el chat; no requiere configurar MCP.
CODE_SEARCH_ENABLED=false
CODE_SEARCH_WORKSPACE=
# Prefijos opcionales requeridos por algunos modelos de embeddings.
CODE_SEARCH_DOCUMENT_PREFIX=
CODE_SEARCH_QUERY_PREFIX=

# Opcional. Si se define, todas las rutas salvo "/" requieren Authorization: Bearer <clave>.
API_KEY=

# Opcionales:
# AGENTS_DIR=config/agentes
# SKILLS_DIR=skills
# LOG_DIR=logs
# STARTUP_TIMEOUT=180
# MODELS_CACHE_TTL=30
# INFERENCE_TIMEOUT_MINUTES=0
# WEB_SEARCH_ENABLED=true
# SEARXNG_URL=http://<host-de-tu-SearXNG>:8888
